{
  "name": "campusrelay-2",
  "version": "2.1.0",
  "private": true,
  "description": "An evidence-backed living timeline for student opportunities",
  "scripts": {
    "dev": "npm run build && node scripts/serve.cjs",
    "build": "node scripts/build.cjs",
    "check": "node scripts/check.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "evaluate": "node scripts/evaluate.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2"
  }
}
